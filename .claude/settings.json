{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) 'scripts/capture-agent-turn.ps1') -Tool 'claude-code'\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) 'scripts/capture-agent-turn.ps1') -Tool 'claude-code'\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

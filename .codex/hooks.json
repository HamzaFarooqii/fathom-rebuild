{
  "description": "Capture user prompts and final assistant responses for the 8x assignment.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) 'scripts/capture-agent-turn.ps1')\"",
            "timeout": 30,
            "statusMessage": "Recording prompt"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command \"& (Join-Path (git rev-parse --show-toplevel) 'scripts/capture-agent-turn.ps1')\"",
            "timeout": 30,
            "statusMessage": "Recording response"
          }
        ]
      }
    ]
  }
}
